<div class="flex justify-center items-center">
  <div class="text-center flex flex-col items-center max-w-[500px]">
    <h2 class="text-lg text-primary font-medium">Ops!</h2>
    <p class="text-secondary text-sm max-w-sm mx-auto mb-4">
      Non hai ancora creato o assegnato categorie di spesa alle tue transazioni.
    </p>

    <div class="flex items-center gap-2">
      <%= render DS::Button.new(
        text: "Usa quelle predefinite (consigliato)",
        href: bootstrap_categories_path,
      ) %>

      <%= render DS::Link.new(
        text: "Nuova categoria",
        variant: "outline",
        icon: "plus",
        href: new_category_path,
        frame: :modal,
      ) %>
    </div>
  </div>
</div>
