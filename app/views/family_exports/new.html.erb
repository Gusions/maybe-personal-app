<%= render DS::Dialog.new do |dialog| %>
  <% dialog.with_header(title: "Esporta i tuoi dati", subtitle: "Scarica tutti i tuoi dati finanziari") %>

  <% dialog.with_body do %>
    <div class="space-y-4">
      <div class="bg-container-inset rounded-lg p-4 space-y-3">
        <h3 class="font-medium text-primary">Cosa è incluso:</h3>
        <ul class="space-y-2 text-sm text-secondary">
          <li class="flex items-start gap-2">
            <%= icon "check", class: "shrink-0 mt-0.5 text-positive" %>
            <span>Tutti i conti e i saldi</span>
          </li>
          <li class="flex items-start gap-2">
            <%= icon "check", class: "shrink-0 mt-0.5 text-positive" %>
            <span>Storico delle transazioni</span>
          </li>
          <li class="flex items-start gap-2">
            <%= icon "check", class: "shrink-0 mt-0.5 text-positive" %>
            <span>Operazioni di investimento</span>
          </li>
          <li class="flex items-start gap-2">
            <%= icon "check", class: "shrink-0 mt-0.5 text-positive" %>
            <span>Categorie e tag</span>
          </li>
        </ul>
      </div>

      <div class="bg-amber-50 border border-amber-200 rounded-lg p-3">
        <p class="text-sm text-amber-800">
          <strong>Nota:</strong> questa esportazione include tutti i tuoi dati, ma solo una parte può essere reimportata in Maybe tramite la funzione di importazione CSV. Supportiamo l'importazione di conti, transazioni (con categoria e tag) e operazioni di investimento. Gli altri dati non possono essere importati e servono solo come archivio personale.
        </p>
      </div>

      <%= form_with url: family_exports_path, method: :post, class: "space-y-4" do |form| %>
        <div class="flex gap-3">
          <%= link_to "Annulla", "#", class: "flex-1 text-center px-4 py-2 border border-primary rounded-lg hover:bg-surface-hover", data: { action: "click->modal#close" } %>
          <%= form.submit "Esporta i dati", class: "flex-1 bg-inverse fg-inverse rounded-lg px-4 py-2 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
