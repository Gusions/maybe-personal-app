<%= content_for :page_title, "Crea nuova chiave API" %>

<%= settings_section title: "Crea nuova chiave API", subtitle: "Genera una nuova chiave API per accedere ai tuoi dati Maybe in modo programmatico." do %>
  <%= styled_form_with model: @api_key, url: settings_api_key_path, class: "space-y-4" do |form| %>
    <%= form.text_field :name,
        placeholder: "es. La mia app di budget, Portfolio Tracker",
        label: "Nome chiave API",
        help_text: "Scegli un nome descrittivo per identificare facilmente questa chiave in futuro." %>

    <div>
      <%= form.label :scopes, "Permessi", class: "block text-sm font-medium text-primary mb-2" %>
      <p class="text-sm text-secondary mb-3">Seleziona i permessi che questa chiave API dovrà avere:</p>

      <div class="space-y-2">
        <% [
          ["read", "Solo lettura", "Visualizza conti, transazioni e saldi"],
          ["read_write", "Lettura/Scrittura", "Visualizza i tuoi dati e crea nuove transazioni"]
        ].each do |value, label, description| %>
          <div class="bg-surface-inset rounded-lg p-3 border border-primary">
            <label class="flex items-start gap-3 cursor-pointer">
              <%= radio_button_tag "api_key[scopes]", value, (@api_key&.scopes || []).include?(value),
                  class: "mt-1" %>
              <div class="flex-1">
                <div class="font-medium text-primary"><%= label %></div>
                <div class="text-sm text-secondary mt-1"><%= description %></div>
              </div>
            </label>
          </div>
        <% end %>
      </div>
    </div>

    <div class="bg-warning-50 border border-warning-200 rounded-xl p-4">
      <div class="flex items-start gap-2">
        <%= icon("alert-triangle", class: "w-5 h-5 text-warning-600 mt-0.5") %>
        <div>
          <h4 class="font-medium text-warning-800 text-sm">Avviso di sicurezza</h4>
          <p class="text-warning-700 text-sm mt-1">
            La tua chiave API verrà mostrata solo una volta dopo la creazione. Assicurati di copiarla e conservarla in modo sicuro.
            Chiunque abbia accesso a questa chiave può accedere ai tuoi dati in base ai permessi selezionati.
          </p>
        </div>
      </div>
    </div>

    <div class="flex justify-end gap-3 pt-4 border-t border-primary">
      <%= render DS::Link.new(
        text: "Annulla",
        href: settings_api_key_path,
        variant: "ghost"
      ) %>

      <%= render DS::Button.new(
        text: "Crea chiave API",
        variant: "primary",
        type: "submit"
      ) %>
    </div>
  <% end %>
<% end %>
