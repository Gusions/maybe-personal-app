<%# locals: (form:, entry:, candidates:, accounts:) %>

<% if candidates.any? %>
  <div data-controller="transfer-match" class="space-y-2">
    <p class="text-sm text-secondary">
      Seleziona un metodo per abbinare le tue transazioni.
    </p>

    <%= form.select :method,
              [
                ["Abbina a una transazione esistente (consigliato)", "existing"],
                ["Crea una nuova transazione", "new"]
              ],
              { selected: "existing", label: "Metodo di abbinamento" },
              data: { action: "change->transfer-match#update" } %>

    <div data-transfer-match-target="existingSelect">
      <%= form.select :matched_entry_id,
                candidates.map { |entry|
                  [entry_name_detailed(entry), entry.id]
                },
                { label: "Transazione da abbinare" } %>
    </div>

    <div data-transfer-match-target="newSelect" class="hidden">
      <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: "Conto di destinazione" } %>
    </div>
  </div>
<% else %>
  <p class="text-sm text-secondary">
    Non abbiamo trovato transazioni da abbinare negli altri tuoi conti.
    Seleziona un conto e creeremo per te una nuova transazione in entrata.
  </p>

  <%= form.hidden_field :method, value: "new" %>

  <div>
    <%= form.select :target_account_id,
                accounts.map { |account| [account.name, account.id] },
                { label: "Conto di destinazione" } %>
  </div>
<% end %>
