<%= link_to "Torna alle regole", rules_path %>

<%= render DS::Dialog.new do |dialog| %>
  <%
    title = if @rule.name.present?
              "Modifica regola #{@rule.resource_type} \"#{@rule.name}\""
            else
              "Modifica regola #{@rule.resource_type}"
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <%= render "rules/form", rule: @rule %>
  <% end %>
<% end %>
