<%# locals: (account:) %>

<%= render DS::Menu.new(testid: "account-menu") do |menu| %>
  <% menu.with_item(variant: "link", text: "Modifica", href: edit_account_path(account), icon: "pencil-line", data: { turbo_frame: :modal }) %>

  <% unless account.crypto? %>
    <% menu.with_item(
      variant: "link",
      text: "Importa transazioni",
      href: imports_path({ import: { type: account.investment? ? "TradeImport" : "TransactionImport", account_id: account.id } }),
      icon: "download",
      data: { turbo_frame: :_top }
    ) %>
  <% end %>

  <% menu.with_item(
    variant: "button",
    text: account.disabled? ? "Attiva conto" : "Disattiva conto",
    href: toggle_active_account_path(account),
    method: :patch,
    icon: account.disabled? ? "eye" : "eye-off",
    data: { turbo_frame: :_top }
  ) %>

  <% unless account.linked? %>
    <% menu.with_item(
      variant: "button",
      text: "Elimina conto",
      href: account_path(account),
      method: :delete,
      icon: "trash-2",
      confirm: CustomConfirm.for_resource_deletion("il conto", high_severity: true),
      data: { turbo_frame: :_top }
    ) %>
  <% end %>
<% end %>
