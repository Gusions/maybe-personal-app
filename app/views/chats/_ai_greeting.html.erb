<div class="flex items-start w-full gap-3 p-2">
  <%= render "chats/ai_avatar" %>

  <div class="max-w-[85%] text-sm space-y-4 text-primary">
    <p>Ciao<%= Current.user&.first_name ? " #{Current.user.first_name}" : "" %>! Sono un'AI creata da Maybe per aiutarti con le tue finanze. Ho accesso al web e ai dati del tuo conto.</p>

    <p>
      Puoi usare <span class="bg-container border border-secondary px-1.5 py-0.5 rounded font-mono text-xs">/</span> per accedere ai comandi
    </p>

    <div class="space-y-3">
      <p>Ecco qualche domanda che puoi farmi:</p>

      <% questions = [
        {
          icon: "chart-area",
          text: "Valuta il portafoglio investimenti"
        },
        {
          icon: "wallet-minimal",
          text: "Mostra analisi delle spese"
        },
        {
          icon: "alert-triangle",
          text: "Trova pattern inusuali"
        }
      ] %>

      <div class="space-y-2.5">
        <% questions.each do |question| %>
          <button data-action="chat#submitSampleQuestion"
                  data-chat-question-param="<%= question[:text] %>"
                  class="w-fit flex items-center gap-2 border border-tertiary rounded-full py-1.5 px-2.5 hover:bg-gray-100">
            <%= icon(question[:icon]) %> <%= question[:text] %>
          </button>
        <% end %>
      </div>
    </div>
  </div>
</div>
