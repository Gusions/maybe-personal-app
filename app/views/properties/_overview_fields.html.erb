<%# locals: (form:) %>

<div class="flex flex-col gap-2">
  <%= form.text_field :name,
                  label: "Nome",
                  placeholder: "Casa al mare",
                  required: true %>

  <%= form.select :subtype,
                Property::SUBTYPES.map { |k, v| [v[:long], k] },
                { prompt: "Seleziona tipo", label: "Tipo di immobile" }, required: true %>

  <%= form.hidden_field :accountable_type, value: "Property" %>

  <%= form.fields_for :accountable do |property_form| %>
    <div class="flex items-center gap-2">
      <%= property_form.number_field :year_built,
                    label: "Anno di costruzione (facoltativo)",
                    placeholder: "1990",
                    min: 1800,
                    max: Time.current.year %>
    </div>

    <div class="flex items-center gap-2">
      <%= property_form.number_field :area_value,
                      label: "Superficie (facoltativo)",
                      placeholder: "1200",
                      min: 0 %>
      <%= property_form.select :area_unit,
                      [["Metri quadrati", "sqm"], ["Piedi quadrati", "sqft"]],
                      { label: "Unità di misura" } %>
    </div>
  <% end %>

</div>
