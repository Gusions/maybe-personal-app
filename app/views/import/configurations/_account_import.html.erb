<%# locals: (import:) %>

<%= styled_form_with model: @import, url: import_configuration_path(@import), scope: :import, method: :patch, class: "space-y-4" do |form| %>
  <%= form.select :entity_type_col_label, import.csv_headers, { include_blank: "Lascia vuoto", label: "Tipo di entità" } %>
  <%= form.select :name_col_label, import.csv_headers, { include_blank: "Lascia vuoto", label: "Nome" }, required: true %>
  <%= form.select :amount_col_label, import.csv_headers, { include_blank: "Lascia vuoto", label: "Saldo" }, required: true %>
  <%= form.select :currency_col_label, import.csv_headers, { include_blank: "Predefinita", label: "Valuta" } %>

  <%= form.submit "Applica configurazione", disabled: import.complete? %>
<% end %>
