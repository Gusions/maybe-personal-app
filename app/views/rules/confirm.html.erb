<%= render DS::Dialog.new(reload_on_close: true) do |dialog| %>
  <%
    title = if @rule.name.present?
              "Conferma le modifiche a \"#{@rule.name}\""
            else
              "Conferma le modifiche"
            end
  %>
  <% dialog.with_header(title: title) %>

  <% dialog.with_body do %>
    <p class="text-secondary text-sm mb-4">
      Stai per applicare questa regola a
      <span class="text-primary font-medium"><%= @rule.affected_resource_count %> <%= @rule.resource_type.pluralize %></span>
      che soddisfano i criteri specificati nella regola. Conferma se vuoi procedere con questa modifica.
    </p>

    <%= render DS::Button.new(
      text: "Conferma le modifiche",
      href: apply_rule_path(@rule),
      method: :post,
      full_width: true,
      data: { turbo_frame: "_top" }) %>
  <% end %>
<% end %>
