<%= render DS::Dialog.new(variant: "drawer", frame: "bulk_transaction_edit_drawer") do |dialog| %>
  <% dialog.with_header(title: "Modifica transazioni", data: { bulk_select_target: "bulkEditDrawerHeader" }) %>

  <% dialog.with_body do %>
    <%= styled_form_with url: transactions_bulk_update_path, scope: "bulk_update", class: "h-full flex flex-col justify-between gap-4", data: { turbo_frame: "_top" } do |form| %>
      <div class="space-y-4">
        <%= render DS::Disclosure.new(title: "Panoramica", open: true) do %>
          <div class="pb-6 space-y-2">
            <%= form.date_field :date, label: "Data", max: Date.current %>
          </div>
        <% end %>

        <%= render DS::Disclosure.new(title: "Transazioni", open: true) do %>
          <div class="space-y-2">
            <%= form.collection_select :category_id, Current.family.categories.alphabetically, :id, :name, { prompt: "Seleziona una categoria", label: "Categoria", class: "text-subdued" } %>
            <%= form.collection_select :merchant_id, Current.family.merchants.alphabetically, :id, :name, { prompt: "Seleziona un esercente", label: "Esercente", class: "text-subdued" } %>
            <%= form.select :tag_ids, Current.family.tags.alphabetically.pluck(:name, :id), { include_blank: "Nessuno", multiple: true, label: "Tag", container_class: "h-40" } %>
            <%= form.text_area :notes, label: "Note", placeholder: "Inserisci una nota da applicare alle transazioni selezionate", rows: 5 %>
          </div>
        <% end %>
      </div>

      <div class="flex justify-end gap-2 mt-auto">
        <%= render DS::Button.new(text: "Annulla", variant: "ghost", data: { action: "click->dialog#close" }) %>
        <%= render DS::Button.new(text: "Salva", data: { bulk_select_scope_param: "bulk_update", action: "bulk-select#submitBulkRequest" }) %>
      </div>
    <% end %>
  <% end %>
<% end %>
