<%= turbo_stream.update "main" do %>
  <div class="relative max-w-4xl mx-auto flex flex-col w-full h-full">
    <div class="grow space-y-4 overflow-y-auto -mx-1 px-1 pb-12">
      <h1 class="text-primary text-3xl md:text-xl font-medium">
        Chiave API creata
      </h1>

      <%= settings_section title: "Chiave API creata con successo", subtitle: "La tua nuova chiave API è stata generata con successo." do %>
        <div class="space-y-4">
          <div class="p-3 shadow-border-xs bg-container rounded-lg">
            <div class="flex items-start gap-3">
              <%= render DS::FilledIcon.new(
                icon: "check-circle",
                rounded: true,
                size: "lg",
                variant: :success
              ) %>
              <div class="flex-1">
                <h3 class="font-medium text-primary">Chiave API creata con successo!</h3>
                <p class="text-secondary text-sm mt-1">La tua nuova chiave API "<%= @api_key.name %>" è stata creata ed è pronta all'uso.</p>
              </div>
            </div>
          </div>

          <div class="bg-surface-inset rounded-xl p-4">
            <h4 class="font-medium text-primary mb-3">La tua chiave API</h4>
            <p class="text-secondary text-sm mb-3">Copia e conserva questa chiave in modo sicuro. Ti servirà per autenticare le tue richieste API.</p>

            <div class="bg-container rounded-lg p-3 border border-primary" data-controller="clipboard">
              <div class="flex items-center justify-between gap-3">
                <code id="api-key-display" class="font-mono text-sm text-primary break-all" data-clipboard-target="source"><%= @api_key.plain_key %></code>
                <%= render DS::Button.new(
                  text: "Copia chiave API",
                  variant: "ghost",
                  icon: "copy",
                  data: { action: "clipboard#copy" }
                ) %>
              </div>
            </div>
          </div>

          <div class="bg-surface-inset rounded-xl p-4">
            <h4 class="font-medium text-primary mb-3">Dettagli chiave</h4>
            <div class="space-y-2 text-sm">
              <div class="flex justify-between">
                <span class="text-secondary">Nome:</span>
                <span class="text-primary font-medium"><%= @api_key.name %></span>
              </div>
              <div class="flex justify-between">
                <span class="text-secondary">Permessi:</span>
                <span class="text-primary">
                  <%= @api_key.scopes.map { |scope|
                    case scope
                    when "read_accounts" then "Visualizza conti"
                    when "read_transactions" then "Visualizza transazioni"
                    when "read_balances" then "Visualizza saldi"
                    when "write_transactions" then "Crea transazioni"
                    else scope.humanize
                    end
                  }.join(", ") %>
                </span>
              </div>
              <div class="flex justify-between">
                <span class="text-secondary">Creata il:</span>
                <span class="text-primary"><%= @api_key.created_at.strftime("%d %B %Y alle %H:%M") %></span>
              </div>
            </div>
          </div>

          <div class="bg-warning-50 border border-warning-200 rounded-xl p-4">
            <div class="flex items-start gap-2">
              <%= icon("alert-triangle", class: "w-5 h-5 text-warning-600 mt-0.5") %>
              <div>
                <h4 class="font-medium text-warning-800 text-sm">Nota di sicurezza importante</h4>
                <p class="text-warning-700 text-sm mt-1">
                  Questa è l'unica volta in cui la tua chiave API verrà mostrata. Assicurati di copiarla ora e conservarla in modo sicuro.
                  Se perdi questa chiave, dovrai generarne una nuova.
                </p>
              </div>
            </div>
          </div>

          <div class="bg-surface-inset rounded-xl p-4">
            <h4 class="font-medium text-primary mb-3">Come usare la tua chiave API</h4>
            <p class="text-secondary text-sm mb-3">Includi la tua chiave API nell'header X-Api-Key quando effettui le richieste:</p>
            <div class="bg-container rounded-lg p-3 font-mono text-sm text-primary border border-primary">
              curl -H "X-Api-Key: <%= @api_key.plain_key %>" <%= request.base_url %>/api/v1/accounts
            </div>
          </div>

          <div class="flex justify-end pt-4 border-t border-primary">
            <%= render DS::Link.new(
              text: "Vai alle impostazioni chiave API",
              href: settings_api_key_path,
              variant: "primary"
            ) %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
